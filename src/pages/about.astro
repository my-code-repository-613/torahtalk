---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import fs from 'node:fs';
const html = marked.parse(fs.readFileSync('src/content/pages/about.md', 'utf8'));
---
<Base title="About Rabbi Seplowitz">
  <h1 class="text-3xl font-semibold text-wine-dark mb-6">About Rabbi Seplowitz</h1>
  <div class="prose-essay" set:html={html} />
</Base>
