---
import Base from '../layouts/Base.astro';
---
<Base title="Subscribe">
  <div class="max-w-xl">
    <h1 class="text-3xl font-semibold text-wine-dark mb-3">Get Torah Talk by email</h1>
    <p class="mb-6">One message a week, before Shabbos. No ads, no sharing of your address.</p>
    <!-- TODO: replace with the real email-list form once the list provider is chosen -->
    <form class="font-sans text-sm flex gap-2" action="#" method="post">
      <input type="email" name="email" required placeholder="you@example.com" class="flex-1 border border-rule rounded px-3 py-2 bg-white" />
      <button class="bg-wine text-paper px-5 py-2 rounded hover:bg-wine-dark">Subscribe</button>
    </form>
    <p class="font-sans text-xs text-muted mt-4">Prefer a feed reader? <a href="/rss.xml" class="text-wine hover:underline">RSS</a></p>
  </div>
</Base>
